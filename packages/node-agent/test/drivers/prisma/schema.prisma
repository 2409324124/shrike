generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Note {
  id    Int    @id @default(autoincrement())
  title String
  body  String
  createdAt DateTime @default(now())
  @@map("notes")
}

model Tag {
  id    Int    @id @default(autoincrement())
  label String
  @@map("prisma_tags")
}
